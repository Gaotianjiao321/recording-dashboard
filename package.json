{
  "name": "recording-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,desktop -c blue,magenta \"pnpm api:dev\" \"pnpm tauri:dev\"",
    "api:dev": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build",
    "tauri:dev": "tauri dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@tauri-apps/api": "^2.5.0",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.7.10",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
