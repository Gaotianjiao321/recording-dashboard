{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recording Dashboard",
  "version": "0.1.0",
  "identifier": "ai.multica.recording-dashboard",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "beforeBuildCommand": "pnpm web:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recording Dashboard",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

